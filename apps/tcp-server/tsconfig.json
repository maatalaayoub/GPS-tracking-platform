{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "composite": false,
    "paths": {
      "@gps/shared": ["../../packages/shared/dist/index.d.ts"],
      "@gps/database": ["../../packages/database/dist/index.d.ts"]
    }
  },
  "references": [
    { "path": "../../packages/shared" },
    { "path": "../../packages/database/tsconfig.build.json" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
