{
  "name": "@gps/simulator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "simulate": "tsx src/index.ts",
    "simulate:multi": "tsx src/index.ts --multi --count 3 --mode random",
    "simulate:route": "tsx src/index.ts --mode route --route routes/algiers-loop.json --loop"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
