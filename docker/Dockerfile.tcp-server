# syntax=docker/dockerfile:1

# ---- Base ----
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

# ---- Dependencies ----
FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/tcp-server/package.json ./apps/tcp-server/
COPY packages/shared/package.json ./packages/shared/
COPY packages/database/package.json ./packages/database/
RUN pnpm install --frozen-lockfile

# ---- Build ----
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm --filter @gps/tcp-server... build

# ---- Runner ----
FROM base AS runner
ENV NODE_ENV=production
COPY --from=build /app/apps/tcp-server/dist ./apps/tcp-server/dist
COPY --from=build /app/apps/tcp-server/package.json ./apps/tcp-server/
COPY --from=build /app/packages ./packages
COPY --from=build /app/node_modules ./node_modules
EXPOSE 4000 5000
CMD ["node", "apps/tcp-server/dist/index.js"]
